config {
    type: "table",
    schema: "itg",
    name: "tb_itg_trs_tmb001_r0052_sale_atm_debit",
    tags: ["treport"],
    description: "Relatório R0052 — Vendas débito canal ATM (dt_id=7). Inclui todas as transações de débito realizadas em terminais ATM, incluindo Bilhete Único (BU). Para a versão sem BU consultar R0107. Equivalente ao relatório legado R0052 do Postgres.",
    bigquery: {
        partitionBy: "dt_transaction"
    }
}


WITH R0052 AS (
SELECT
    dd.tu_code                                                                              AS cod_atm,
    ttg.description                                                                         AS estacao,
    ttg2.description                                                                        AS linha,
    ttg3.description                                                                        AS empresa,
    ct.ctm_datetime_tz                                                                      AS data_hora_trans,
    DATE(ct.ctm_datetime_tz)                                                                AS data_trans,
    TIME(ct.ctm_datetime_tz)                                                                AS hora_trans,
    ct.ctm_value                                                                            AS valor,
    ct.ctm_receivedvalue                                                                    AS valor_recebido,
    ctxpm.ctmxcpm_nsu_acquirer                                                              AS nsu_adquirente,
    ctxpm.ctmxcpm_aut_acquirer                                                              AS cod_aprov_adquirente,
    CASE WHEN cp.cpt_id = '5' THEN 'BU' ELSE 'TOP' END                                    AS tipo_produto,
    cp.cp_id                                                                                AS codigo_produto,
    cp.cp_desc                                                                              AS produto,
    mtp.code                                                                                AS aplicacao,
    ct.ctm_id                                                                               AS idtrn,
    ct.ctm_status                                                                           AS status_orbi,
    ct.ctt_id
FROM ${ref("tb_his_trs_tmb001_com_tranmt")} ct
--`prd-autopass-ed-001.his.tb_his_trs_tmb001_com_tranmt`                 ct
JOIN  ${ref("tb_his_mrd_tmb001_com_merchant")}  cm    ON cm.cm_id    = ct.cm_id
-- `prd-autopass-ed-001.his.tb_his_mrd_tmb001_com_merchant`               cm    ON cm.cm_id    = ct.cm_id

JOIN ${ref("tb_his_trs_tmb001_com_trandt")}
--`prd-autopass-ed-001.his.tb_his_trs_tmb001_com_trandt`                 ctd   ON ctd.ctm_id  = ct.ctm_id

JOIN ${ref("tb_his_mrd_tmb001_com_product")}
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_com_product`                cp    ON cp.cp_id    = ctd.cp_id

JOIN ${ref("tb_his_mrd_tmb001_com_product_type")}
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_com_product_type`           cpt   ON cpt.cpt_id  = cp.cpt_id

LEFT JOIN ${ref("tb_his_mrd_tmb001_medtransitproduct")}
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_medtransitproduct`     mtp   ON mtp.description = cp.cp_desc

JOIN ${ref("tb_his_trs_tmb001_com_tranmt_x_payment_mode")} ctxpm ON ctxpm.ctm_id = ct.ctm_id
                                                                                   AND ctxpm.cpm_id = '2'
--`prd-autopass-ed-001.his.tb_his_trs_tmb001_com_tranmt_x_payment_mode`  ctxpm ON ctxpm.ctm_id = ct.ctm_id
                                                                                  -- AND ctxpm.cpm_id = '2'
LEFT JOIN ${ref("tb_his_mrd_tmb001_dvc_device")}   dd    ON dd.dv_id    = ct.dv_id
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_dvc_device`            dd    ON dd.dv_id    = ct.dv_id

LEFT JOIN ${ref("tb_his_mrd_tmb001_toterminal")}  tt    ON tt.code     = dd.tu_code
                                                                                   AND tt.toTransportOperatorId = cm.cm_organization_id
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_toterminal`            tt    ON tt.code     = dd.tu_code
                                                                                --   AND tt.toTransportOperatorId = cm.cm_organization_id

LEFT JOIN ${ref("tb_his_mrd_tmb001_toterminalgroup")}   ttg   ON ttg.id      = tt.toTerminalGroupId

--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_toterminalgroup`       ttg   ON ttg.id      = tt.toTerminalGroupId

LEFT JOIN ${ref("tb_his_mrd_tmb001_toterminalgroup")} ttg2  ON ttg2.id     = ttg.parentId
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_toterminalgroup`       ttg2  ON ttg2.id     = ttg.parentId

LEFT JOIN ${ref("tb_his_mrd_tmb001_toterminalgroup")} ttg3  ON ttg3.id     = ttg2.parentId
--`prd-autopass-ed-001.his.tb_his_mrd_tmb001_toterminalgroup`       ttg3  ON ttg3.id     = ttg2.parentId

WHERE ct.ctt_id IN ('200', '2')
  AND dd.dt_id  = '7'
  AND DATE(ct.ctm_datetime_tz) >= '2025-01-01'

)

SELECT
    idtrn  cd_transaction,
    ctt_id   cd_com_transaction, 
    cod_atm cd_pos_device,
    data_hora_trans  dh_transaction,
    data_trans  dt_transaction,
    hora_trans tm_transaction,
    upper(empresa)  nm_company,
    upper(linha)  nm_line,
    upper(estacao)  nm_station, 
    upper(tipo_produto)  ds_product_type,
    codigo_produto  cd_product_type,
    upper(produto)  ds_product,
    aplicacao  cd_product,
    nsu_adquirente  nr_nsu_acquirer,
    cod_aprov_adquirente  cd_acquirer_authorization,
    upper(status_orbi)  ds_status,
    valor  vl_transaction,
    valor_recebido  vl_received,  
    CURRENT_TIMESTAMP() ts_processing,
    'AUT001' cd_company,
    CAST(FORMAT_TIMESTAMP("%Y%m%d%H%M%S", CURRENT_TIMESTAMP()) AS INT64) nr_load_control,
    SESSION_USER() cd_created_by,
    'TMB001' cd_system_source         
FROM R0052
