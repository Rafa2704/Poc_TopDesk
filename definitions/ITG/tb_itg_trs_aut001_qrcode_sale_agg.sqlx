config {
    type: "table", 
    schema: "itg",
    name: "tb_itg_trs_aut001_qrcode_sale_agg",
    tags: ["treport"],
    description: "Visão consolidada e agregada das vendas de QRCode por dispositivo, linha, estação e modalidade de pagamento. Consolida dados legados e novos relatórios (R0097, R0108, R0109, R0110, R0113, R0115, R0117 e R0123).",
    bigquery: {
        partitionBy: "dt_transaction"                                         
    },
   
}






WITH BASE AS (
-- fluxo atual
SELECT
    dt_transaction,
    cd_pos_device,
    nm_company        AS nm_company,
    nm_line,
    nm_station,
    ds_status_sale    AS ds_status,
    ds_device_type,
    ds_payment_mode,
    SUM(qt_ticket)      AS qt_sale,
    SUM(vl_sale)      AS vl_sale,
    'n/a'             AS ds_treport_name
FROM `prd-autopass-bi-001.itg.tb_itg_trs_top001_qrcode_sale_agg`
WHERE ((ds_device_type = 'ATM' AND dt_transaction < '2026-05-01') OR ds_device_type <> 'ATM')
AND cd_pos_device <> '267'
GROUP BY ALL

UNION ALL

SELECT
    dt_transaction,
    cd_pos_device,
    ds_sale_network        AS nm_company,
    nm_line,
    nm_station,
    ds_status     AS ds_status,
   'BILHETERIA'   AS  ds_device_type,
    ds_payment_mode,
   -- SUM(qt_ticket)      AS qt_sale,
    SUM(qt_transaction)  qt_venda,
    SUM(valor_total)      AS vl_sale,
    'h0097'             AS ds_treport_name
FROM ${ref("tb_itg_trs_tmb001_r0097_sale_ticket")}
--`dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0097_sale_ticket` 
WHERE ds_device_type = 'POS'
--(ds_device_type = 'ATM' AND dt_transaction < '2026-05-01') OR ds_device_type <> 'ATM'
GROUP BY ALL

UNION ALL



select 
  dt_transaction,
  cd_pos_device,
  nm_company,
  nm_line,
  nm_station,
  ds_status,
  'ATM' ds_device_type,
  'PIX' ds_payment_mode,
  SUM(vl_received) / 5.4 AS qt_venda,
 -- count(cd_transaction) qt_venda,
  sum(vl_received) vl_recebido,
  'r0117' as ds_treport_name
from ${ref("tb_itg_trs_tmb001_r0117_sale_atm_pix_abasp")}
-- `dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0117_sale_atm_pix_abasp`
where ds_product like '%QRCODE%'
and dt_transaction >= '2026-05-01'
group by all
 
 union all
 select dt_transaction,cd_pos_device, nm_company, nm_line, nm_station, ds_status,
 'ATM' ds_device_type,
 'DINHEIRO' ds_payment_mode,
  SUM(vl_received) / 5.4 AS qt_venda,
-- COUNT(cd_transaction)qt_venda,
 sum(vl_received) vl_recebido,
 'r0115' as ds_treport_name
 from  ${ref("tb_itg_trs_tmb001_r0115_sale_atm_cash_abasp")}
 --`dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0115_sale_atm_cash_abasp`
 where ds_product like '%QRCODE%'
 and dt_transaction >= '2026-05-01'
 group by all
 
 union all
 select dt_transaction,cd_pos_device, ''nm_company, ''nm_line, ''nm_station, ds_status,
 'ATM' ds_device_type,
 'VOUCHER' ds_payment_mode,
  SUM(vl_received) / 5.4 AS qt_venda,
 --COUNT(cd_transaction)qt_venda,
 sum(vl_received) vl_recebido,
  'r0113' as ds_treport_name
 from ${ref("tb_itg_trs_tmb001_r0113_sale_atm_voucher_abasp")}
 --`dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0113_sale_atm_voucher_abasp`
 where ds_product_type like '%QRCODE%'
 and dt_transaction >= '2026-05-01'
 group by all
 
union all
select dt_transaction,cd_pos_device, nm_company, nm_line, nm_station, ds_status,
'ATM' ds_device_type,
'DEBITO' ds_payment_mode,
 SUM(vl_received) / 5.4 AS qt_venda,
--COUNT(cd_transaction)qt_venda,
sum(vl_received) vl_recebido ,
'r0123' as ds_treport_name

from ${ref("tb_itg_trs_tmb001_r0123_sale_atm_debit")}
--dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0123_sale_atm_debit
--`dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0052_sale_atm_debit`
where ds_product like '%QRCODE%'
and dt_transaction >= '2026-05-01'
group by all


