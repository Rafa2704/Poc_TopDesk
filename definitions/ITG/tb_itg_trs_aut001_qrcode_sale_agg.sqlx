--     SUM(vl_received)    AS vl_sale,
--     'r0107'             AS ds_treport_name
-- FROM `dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0107_sale_atm_consolidated_abasp`
-- WHERE ds_device_type = 'ATM'
--   AND ds_product LIKE '%QRCODE%'
--   AND dt_transaction >= '2025-01-01'
-- GROUP BY ALL

UNION ALL

-- apps pix novo
SELECT
    dt_transaction,
    cd_pos_device,
    NULL              AS nm_company,
    NULL              AS nm_line,
    NULL              AS nm_station,
    ds_status,
    'Novo App Pix'    AS ds_device_type,
    ds_payment_mode,
     SUM(vl_total) / 5.4 AS qt_venda,
   -- SUM(qt_transaction) AS qt_sale,
    SUM(vl_total)       AS vl_sale,
    'r0108'             AS ds_treport_name
FROM `dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0108_sale_app_pix`
WHERE ds_product = 'QRCODE UNITARIO'
GROUP BY ALL

UNION ALL

-- app débito novo
SELECT
    data_trans        AS dt_transaction,
    NULL              AS cd_pos_device,
    NULL              AS nm_company,
    NULL              AS nm_line,
    NULL              AS nm_station,
    status_orbi       AS ds_status,
    'Novo App Debit'  AS ds_device_type,
    forma_pagamento   AS ds_payment_mode,
     SUM(valor_total) / 5.4 AS qt_venda,
   -- SUM(quantidade)   AS qt_sale,
    SUM(valor_total)  AS vl_sale,
    'r0109'           AS ds_treport_name
FROM `dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0109_app_debit`
WHERE produto = 'QRCODE UNITARIO'
GROUP BY ALL

UNION ALL

-- orbi novo whatsapp
SELECT
    dt_transaction,
    cd_pos_device,
    ''                AS nm_company,
    ''                AS nm_line,
    ''                AS nm_station,
    ds_status,
    'Novo Whatsapp'   AS ds_device_type,
    ds_payment_mode,
     SUM(vl_total) / 5.4 AS qt_venda,
  --  COUNT(cd_transaction) AS qt_sale,
    SUM(vl_total)         AS vl_sale,
    'r0110'               AS ds_treport_name
FROM `dev-autopass-bi-001.itg.tb_itg_trs_tmb001_r0110_sale_whatsapp_pix`
WHERE ds_product LIKE '%QRCODE%'
  AND dt_transaction >= '2026-05-01'
GROUP BY ALL
)

SELECT
    dt_transaction,
    cd_pos_device,
    nm_company,
    nm_line,
    nm_station,
    ds_status,
    ds_device_type,
    ds_payment_mode,
    ds_treport_name,
    SUM(qt_sale) AS qt_sale,
    SUM(vl_sale) AS vl_sale
FROM BASE
GROUP BY ALL


 

 