  'DEBITO'                                      AS ds_payment_mode,
  'N/A'                                         AS nr_nsu,
  'N/A'                                         AS ds_operator,
  'N/A'                                         AS nr_registration,
  'N/A'                                         AS ds_session,
  'N/A'                                         AS cd_status,
  'N/A'                                         AS cd_qrcode_media,
  'ATM'                                         AS ds_device_type,
  'N/A'                                         AS ds_serie,
  'N/A'                                         AS ds_pix_tx,
  'N/A'                                         AS ds_pix_end_to_end,
  nsu_adquirente                                AS nr_nsu_acquirer,
  cod_aprov_adquirente                          AS cd_acquirer_authorization,
  'N/A'                                         AS ds_conciliation,
  CAST(NULL AS NUMERIC)                         AS qt_transaction,
  'N/A'                                         AS cd_transaction_cielo,
  'N/A'                                         AS ds_acquirer,
  'N/A'                                         AS ds_card_brand,
  CAST(NULL AS DATE)                            AS dt_open_service,
  CAST(NULL AS TIME)                            AS tm_open_service,
  CAST(NULL AS DATETIME)                        AS dt_close_service,
  'N/A'                                         AS fl_voucher_gerado,
  CAST(NULL AS NUMERIC)                         AS vl_bill_2,
  CAST(NULL AS NUMERIC)                         AS vl_bill_5,
  CAST(NULL AS NUMERIC)                         AS vl_bill_10,
  CAST(NULL AS NUMERIC)                         AS vl_bill_20,
  CAST(NULL AS NUMERIC)                         AS vl_bill_50,
  CAST(NULL AS NUMERIC)                         AS vl_bill_100,
  CAST(NULL AS NUMERIC)                         AS vl_bill_200,
  'R0123_R0052'                                      AS cd_report_origin,
  cpt_id                                       AS filtrobu
FROM R0123_R0052

UNION ALL

SELECT
  idtrn                                         AS cd_transaction,
  'N/A'                                         AS cd_com_transaction,
  cod_atm                                       AS cd_pos_device,
  data_hora_trans                               AS dh_transaction,
  data_trans                                    AS dt_transaction,
  hora_trans                                    AS tm_transaction,
  'N/A'                                         AS ds_type_generation,
  'N/A'                                         AS ds_generation,
  'N/A'                                         AS cd_pos_device_usage,
  CAST(NULL AS DATE)                            AS dt_usage,
  CAST(NULL AS TIME)                            AS tm_usage,
  CAST(NULL AS DATE)                            AS dt_expiration,
  CAST(NULL AS TIME)                            AS tm_expiration,
  'N/A'                                         AS cd_media,
  'N/A'                                         AS nr_voucher,
  upper(tipo_produto)                           AS ds_product_type,
  codigo_produto                                AS cd_product_type, --incluido
  'N/A'                                         AS ds_status_voucher,
  upper(Status)                                 AS ds_status,
  'N/A'                                         AS ds_status_complete,
  ctm_externalid                                AS cd_external,
  ctm_legacy_id                                 AS cd_legacy,
  ctm_value                                     AS vl_transaction,
  ctm_receivedvalue                             AS vl_total,
  'N/A'                                         AS ds_user_issuer,
  'N/A'                                         AS cd_sale_network,
  'N/A'                                         AS ds_sale_network,
  upper(Linha)                                  AS nm_line,
  upper(Estacao)                                AS nm_station,
  upper(Empresa)                                AS nm_company,
  'N/A'                                         AS nm_pdv,
  'N/A'                                         AS ds_terminal,
  upper(produto)                                AS ds_product,
  aplicacao                                     AS cd_product,
  'DINHEIRO'                                    AS ds_payment_mode,--INCLUIDO
  'N/A'                                         AS nr_nsu,
  'N/A'                                         AS ds_operator,
  'N/A'                                         AS nr_registration,
  'N/A'                                         AS ds_session,
  'N/A'                                         AS cd_status,
  'N/A'                                         AS cd_qrcode_media,
  'ATM'                                         AS ds_device_type,
  'N/A'                                         AS ds_serie,
  'N/A'                                         AS ds_pix_tx,
  'N/A'                                         AS ds_pix_end_to_end,
  'N/A'                                         AS nr_nsu_acquirer,
  'N/A'                                         AS cd_acquirer_authorization,
  'N/A'                                         AS ds_conciliation,
  CAST(NULL AS NUMERIC)                         AS qt_transaction,
  'N/A'                                         AS cd_transaction_cielo,
  'N/A'                                         AS ds_acquirer,
  'N/A'                                         AS ds_card_brand,
  date(abertura_servico)                        AS dt_open_service,
  time(abertura_servico)                        AS tm_open_service,
  fechamento_servico                            AS dt_close_service,
  upper(voucher_gerado)                         AS fl_voucher_gerado,
  nota_2                                        AS vl_bill_2,
  nota_5                                        AS vl_bill_5,
  nota_10                                       AS vl_bill_10,
  nota_20                                       AS vl_bill_20,
  nota_50                                       AS vl_bill_50,
  nota_100                                      AS vl_bill_100,
  nota_200                                      AS vl_bill_200,
  'R0115_R0050'                                      AS cd_report_origin,
  cpt_id                                       AS filtrobu
FROM R0115_R0050
)

SELECT
  *,
  CURRENT_TIMESTAMP() AS ts_processing,
  'AUT001' AS cd_company,
  CAST(FORMAT_TIMESTAMP("%Y%m%d%H%M%S", CURRENT_TIMESTAMP()) AS INT64) AS nr_load_control,
  SESSION_USER() AS cd_created_by,
  'TMB001' AS cd_system_source
FROM UNIAO
WHERE TRUE 
 --AND DATE(dt_transaction) >= '2026-08-01'
