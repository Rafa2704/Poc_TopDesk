config {
    type: "table",
    schema: "itg",
    name: "tb_itg_trs_tmb001_r0110_sale_whatsapp_pix",
    tags: ["commercial"],
    description: "Relatório R0110 — Vendas PIX canal WhatsApp novo (cm_id=6). Inclui status de conciliação. Exclui BU. Equivalente ao relatório legado R0110 do Postgres.",
    bigquery: {
        partitionBy: "dt_transaction"
    }
}

WITH R0110 AS (
SELECT
    dd.tu_code                                                                          AS cod_terminal,
    pp.ppx_paymentdate                                                                 AS data_hora_trans,
    DATE(ct.ctm_datetime_tz)                                                           AS data_trans,
    TIME(ct.ctm_datetime_tz)                                                           AS hora_trans,
    ctd.ctm_value                                                                      AS valor,
    ctd.ctm_receivedvalue                                                              AS quantidade,
    ctd.ctm_value * ctd.ctm_receivedvalue                                             AS valor_total,
    cpm.cpm_desc                                                                       AS forma_pagamento,
    ctxpm.ctmxcpm_acquirer_name                                                         AS acquirer_name,
    ctxpm.ctmxcpm_brand                                                                AS bandeira,
    ctxpm.ctmxcpm_nsu_acquirer                                                         AS nsu_adquirente,
    ctxpm.ctmxcpm_aut_acquirer                                                         AS cod_aprov_adquirente,
    ctxpm.ctmxcpm_pix_txid                                                              AS pix_tx_id,
    ctxpm.ctmxcpm_pix_endtoendid                                                       AS pix_end_to_end,
    CASE WHEN cp.cpt_id = '5' THEN 'BU' ELSE 'TOP' END                                 AS tipo_produto,
    cp.cp_id                                                                           AS codigo_produto,
    cp.cp_desc                                                                         AS produto,
    mtp.code                                                                           AS aplicacao,
    ct.ctm_id                                                                          AS idtrn,
    cts.cts_shortdesc                                                                  AS status_orbi,
    CASE ctxpm.ctmxcpm_conciliation_status
        WHEN 'C' THEN 'Conciliado'
        WHEN 'D' THEN 'Divergência valor'
        ELSE 'Não conciliado'
    END                                                                                AS conciliacao
FROM ${ref("tb_his_trs_tmb001_com_tranmt")}                                            ct
JOIN ${ref("tb_his_mrd_tmb001_com_merchant")}                                         cm    ON cm.cm_id    = ct.cm_id
JOIN ${ref("tb_his_trs_tmb001_com_trandt")}                                           ctd   ON ctd.ctm_id  = ct.ctm_id
LEFT JOIN ${ref("tb_his_mrd_tmb001_com_product")}                                     cp    ON cp.cp_id    = ctd.cp_id
JOIN ${ref("tb_his_mrd_tmb001_com_product_type")}                                     cpt   ON cpt.cpt_id  = cp.cpt_id
LEFT JOIN ${ref("tb_his_mrd_tmb001_medtransitproduct")}                               mtp   ON mtp.description = cp.cp_desc
JOIN ${ref("tb_his_trs_tmb001_com_tranmt_x_payment_mode")}                            ctxpm ON ctxpm.ctm_id = ct.ctm_id
JOIN ${ref("tb_his_mrd_tmb001_com_payment_mode")}                                     cpm   ON cpm.cpm_id  = ctxpm.cpm_id
JOIN ${ref("tb_his_mrd_tmb001_dvc_device")}                                           dd    ON dd.dv_id    = ct.dv_id
JOIN ${ref("tb_his_mrd_tmb001_com_tran_status")}                                      cts   ON cts.cts_id  = ct.ctm_status
JOIN ${ref("tb_his_trs_tmb001_pay_pix")}                                              pp    ON ctxpm.ptr_id = pp.ptr_id
WHERE TRUE 
--ct.ctt_id IN ('1', '2')
  AND ct.cm_id   = '6'
  AND (cp.cpt_id != '5' OR cp.cpt_id IS NULL)
)

SELECT
    idtrn  cd_transaction,
    cod_terminal cd_pos_device,
    data_hora_trans dh_transaction,
    data_trans dt_transaction,
    hora_trans tm_transaction,
    upper(tipo_produto)  ds_product_type,
    codigo_produto  cd_product_type,
    upper(produto)  ds_product,
    aplicacao  cd_product,
    UPPER(acquirer_name)  ds_acquirer,
    nsu_adquirente  nr_nsu_acquirer,
    cod_aprov_adquirente  cd_acquirer_authorization,
    pix_tx_id  ds_pix_tx,
    pix_end_to_end  ds_pix_end_to_end,
    UPPER(status_orbi) ds_status,
    UPPER(conciliacao ) ds_conciliation,
    UPPER(forma_pagamento)  ds_payment_mode,
    UPPER(bandeira) ds_card_brand,
    quantidade  qt_transaction,
    valor  vl_transaction,    
    valor_total  vl_total,
    CURRENT_TIMESTAMP() ts_processing,
    'AUT001' cd_company,
    CAST(FORMAT_TIMESTAMP("%Y%m%d%H%M%S", CURRENT_TIMESTAMP()) AS INT64) nr_load_control,
    SESSION_USER() cd_created_by,
    'TMB001' cd_system_source
FROM R0110
-- WHERE data_trans >= '2025-01-01'