config {
    type: "table",
    schema: "day",
    name: "tb_day_trs_tmb001_trn_usageqrcode",
    tags: ["commercial"],
    description: "Tabela trn_usageqrcode tipada — uso de QRCode em terminais"
}

SELECT
    REGEXP_REPLACE(tuq_id,                  r'\.0$', '') AS tuq_id,
    REGEXP_REPLACE(tt_id,                   r'\.0$', '') AS tt_id,
    REGEXP_REPLACE(tuq_recordsequence,      r'\.0$', '') AS tuq_recordsequence,
    REGEXP_REPLACE(tuq_systemcode,          r'\.0$', '') AS tuq_systemcode,
    REGEXP_REPLACE(tuq_transportoperatorid, r'\.0$', '') AS tuq_transportoperatorid,
    REGEXP_REPLACE(tuq_lineid,              r'\.0$', '') AS tuq_lineid,
    REGEXP_REPLACE(tuq_usagesequence,       r'\.0$', '') AS tuq_usagesequence,
    REGEXP_REPLACE(tuq_latitude,            r'\.0$', '') AS tuq_latitude,
    REGEXP_REPLACE(tuq_longitude,           r'\.0$', '') AS tuq_longitude,
    SAFE.DATETIME(SAFE_CAST(tuq_usagetimestamp_tz     AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_usagetimestamp_tz,
    REGEXP_REPLACE(tuq_elapsedtime,         r'\.0$', '') AS tuq_elapsedtime,
    REGEXP_REPLACE(tuq_isoffline,           r'\.0$', '') AS tuq_isoffline,
    REGEXP_REPLACE(tuq_istimeout,           r'\.0$', '') AS tuq_istimeout,
    REGEXP_REPLACE(tuq_qrmediaid,           r'\.0$', '') AS tuq_qrmediaid,
    REGEXP_REPLACE(tuq_qrmediaexternalid,   r'\.0$', '') AS tuq_qrmediaexternalid,
    REGEXP_REPLACE(tuq_qrmediatype,         r'\.0$', '') AS tuq_qrmediatype,
    REGEXP_REPLACE(tuq_producttype,         r'\.0$', '') AS tuq_producttype,
    REGEXP_REPLACE(tuq_productcode,         r'\.0$', '') AS tuq_productcode,
    REGEXP_REPLACE(tuq_issuercode,          r'\.0$', '') AS tuq_issuercode,
    REGEXP_REPLACE(tuq_usagemode,           r'\.0$', '') AS tuq_usagemode,
    REGEXP_REPLACE(tuq_fareruleid,          r'\.0$', '') AS tuq_fareruleid,
    REGEXP_REPLACE(tuq_usagevalue,          r'\.0$', '') AS tuq_usagevalue,
    REGEXP_REPLACE(tuq_usagelimit,          r'\.0$', '') AS tuq_usagelimit,
    SAFE.DATETIME(SAFE_CAST(tuq_generatedtimestamp_tz AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_generatedtimestamp_tz,
    SAFE.DATETIME(SAFE_CAST(tuq_issuetimestamp_tz     AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_issuetimestamp_tz,
    SAFE.DATETIME(SAFE_CAST(tuq_validitytimestamp_tz  AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_validitytimestamp_tz,
    REGEXP_REPLACE(tuq_groupid,             r'\.0$', '') AS tuq_groupid,
    REGEXP_REPLACE(tuq_abtwalletid,         r'\.0$', '') AS tuq_abtwalletid,
    tuq_tokentimestamp_tz     AS tuq_tokentimestamp_tz,
    SAFE.DATETIME(SAFE_CAST(tuq_createdat_tz          AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_createdat_tz,
    SAFE.DATETIME(SAFE_CAST(tuq_updatedat_tz          AS TIMESTAMP), 'America/Sao_Paulo') AS tuq_updatedat_tz,
    tuq_blameuser,
    REGEXP_REPLACE(tuq_terminalid,          r'\.0$', '') AS tuq_terminalid,
    tuq_islegacy,
    REGEXP_REPLACE(tuq_hotlistfileid,       r'\.0$', '') AS tuq_hotlistfileid,
    REGEXP_REPLACE(tuq_hotlistfilesequence, r'\.0$', '') AS tuq_hotlistfilesequence,
    REGEXP_REPLACE(tuq_deviceserial,        r'\.0$', '') AS tuq_deviceserial,
    SAFE_CAST(tq_server_date AS DATE)                    AS tq_server_date,
    REGEXP_REPLACE(tq_message_id,           r'\.0$', '') AS tq_message_id,
    REGEXP_REPLACE(tq_source,               r'\.0$', '') AS tq_source,

    "TMB001" AS origem,
    CURRENT_TIMESTAMP() AS dt_processamento,
    SESSION_USER() AS usuario_processamento

FROM ${ref("tb_ext_trs_tmb001_trn_usageqrcode")}